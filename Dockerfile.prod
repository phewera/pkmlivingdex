# Stage 1: Fetch source code from GitHub
FROM alpine/git as fetcher
ARG APP_VERSION=main
WORKDIR /app
RUN git clone --branch ${APP_VERSION} --depth 1 https://github.com/phewera/pkmlivingdex.git .

# Stage 2: Build Frontend
FROM node:18-alpine as frontend-builder
WORKDIR /app/frontend
# Copy frontend source from fetcher
COPY --from=fetcher /app/frontend ./
# Install dependencies and build
RUN npm ci
# Set API URL to empty string for relative paths
ENV VITE_API_URL=
RUN npm run build

# Stage 3: Final Runtime Image
FROM python:3.11-slim

# Install system dependencies (Nginx, Supervisor)
RUN apt-get update && apt-get install -y \
    nginx \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Backend Code
COPY --from=fetcher /app/backend /app/backend
COPY --from=fetcher /app/backend/requirements.txt /app/

# Install Python dependencies
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy Built Frontend Assets
COPY --from=frontend-builder /app/frontend/dist /usr/share/nginx/html

# Copy Nginx Configuration from repo and adjust for local backend
COPY --from=fetcher /app/frontend/nginx.conf /etc/nginx/conf.d/default.conf
RUN sed -i 's/backend:8000/127.0.0.1:8000/g' /etc/nginx/conf.d/default.conf

# Copy Supervisor Configuration
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Expose Port 80
EXPOSE 80

# Start Supervisor
CMD ["/usr/bin/supervisord"]
